# ==============================================================================
# Wi-Fi NeRF Floorplan Reconstructor Configuration
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Choose ONE of the following options for BLOB_URI:

# Option 1: Local storage directory (Default & fastest offline mode)
# If you download/sync your bucket files to a local folder:
BLOB_URI=./blob_store

# Option 2: Direct OCI Pre-Authenticated Request (PAR) URL
# Paste the exact OCI PAR bucket URL used by the Android app:
# BLOB_URI=https://objectstorage.us-ashburn-1.oraclecloud.com/p/EXAMPLE_TOKEN/n/NAMESPACE/b/wifi-mapping-telemetry/o

# Option 3: Direct OCI Bucket protocol (requires ~/.oci/config and OCI CLI/SDK)
# BLOB_URI=oci://my-bucket-name@my-tenancy-namespace/fleet

# Option 4: AWS S3 or MinIO bucket
# BLOB_URI=s3://my-bucket-name/fleet

# Optional: Default target environment ID to reconstruct
# If omitted, run with --list-partitions to see all discovered spaces.
# ENV_ID=residence_oak_42

# Optional: Output directory for floorplan GeoJSON, manifest, and HTML viewer
OUTPUT_DIR=./output
